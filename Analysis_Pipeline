nanoplot_output  SRR32410565.1  SRR32410565.1.fastq  SRR32410565.1_q20.fastq

xdg-open SRR32410565.1_output_q20/NanoPlot-report.html

## Part 4
## Genome assembly
#Number of threads 4, genome size is -809.3m, -hq because it raw reads from Oxford nanopore are expected to be already of higher quality high quality.

flye --nano-hq SRR32410565.1.fastq \
--genome-size 809.3m \
--threads 4 \
--out-dir SRR32410565_flye_out

##  Part 5 
## Alignment using minimap2

conda install -c bioconda minimap2

# Mapping the assembled genome to the refernce genome
minimap2 -ax asm5  -t 4 GCF_000006945.2_ASM694v2_genomic.fna  assembly.fasta > Sal_aln.sam

# Mapping the raw reads to the refernce genome
minimap2 -ax map-ont -t 4 GCF_000006945.2_ASM694v2_genomic.fna SRR32410565.1.fastq > reads_ref_aln.sam

## Part 6
## Assembly evaluation using Seqkit

seqkit stats assembly.fasta
file            format  type  num_seqs    sum_len  min_len    avg_len    max_len
assembly.fasta  FASTA   DNA          3  5,104,812  109,059  1,701,604  3,318,776

## Part 7
## Preprocessing for Variant Calling using Samtools

conda install -c bioconda samtools
samtools view -bS reads_ref_aln.sam -o reads_ref_aln.bam
samtools sort reads_ref_aln.sam -o reads_ref_aln.sorted.bam
samtools index reads_ref_aln.sorted.bam

## Part 8 
## Variant Calling using Bcftools

conda install -c bioconda bcftools
bcftools mpileup -f GCF_000006945.2_ASM694v2_genomic.fna --max-depth 2000 reads_ref_aln.sorted.bam | \ bcftools call -mv -Ov -o variants.vcf
bcftools stats variants2000.2.vcf | grep ^SN
