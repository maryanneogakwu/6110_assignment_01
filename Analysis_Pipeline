#!/bin/bash
# Salmonella enterica Long Read Genome Analysis Pipeline

## Part 1
## Download raw reads
wget https://sra-downloadb.be-md.ncbi.nlm.nih.gov/sos7/sra-pub-run-38/SRR032/32410/SRR32410565/SRR32410565.1

# Reads were in SRA format so they needed to be converted to fastq format to be readable and useable.
# Conversion was done using SRAtools in a conda environment

conda activate
conda install -c bioconda sra-tools=3.0.5

fasterq-dump SRR32410565.1
spots read      : 196,031
reads read      : 196,031
reads written   : 196,031

# Checking whether the conversion was successful

ls
SRR32410565.1  SRR32410565.1.fastq

