## Part 9
## Visualization using IGV

conda install bioconda::igv

# Load Genome from File - `GCF_000006945.2_ASM694v2_genomic.fna`
# Load from File - `reads_ref_aln.sorted.bam` and `variants.vcf`

## Part 10 
## Generating Files used for R visualization

#To be used to construct a heatmap showing the variant positions
bcftools query -f '%CHROM\t%POS\n' variants.vcf > variant_positions.tsv
in r -library(ggplot2)

variants <- read.table("variant_positions.tsv", header=FALSE)
colnames(variants) <- c("chrom", "pos")

#To be used to create a variant density plot
awk '{
    window = int($2/10000);
    counts[window]++
}
END {
    for (w in counts)
        print w*10000, counts[w]
}' variant_positions.tsv | sort -n > variant_density.tsv


#To be used to construct a Rainfall plot to show the distribution of SNPs, insertions and deletions
#Extracting the relevant fields
bcftools query -f '%CHROM\t%POS\t%REF\t%ALT\n' variants2000.2.vcf > variant_types.tsv

#Adding variant types (SNP / INS / DEL)
awk 'BEGIN{OFS="\t"}
{
  if(length($3)==1 && length($4)==1) type="SNP";
  else if(length($3)<length($4)) type="INS";
  else type="DEL";
  print $1,$2,$3,$4,type
}' variant_types.tsv > variants_for_plots.tsv

#Sort by chromosome and position
sort -k1,1 -k2,2n variants_for_plots.tsv > variants_sorted.tsv


