## Dowload the refernce genome

conda create -n ncbi_datasets
conda activate ncbi_datasets
conda install -c conda-forge ncbi-datasets-cli
datasets download genome accession GCF_000006945.2 --include genome --filename salm_LT2.zip

## Part 2
## Quality assessment of raw reads using Nanoplot

conda activate genome_assembly
NanoPlot --fastq SRR32410565.1.fastq -o nanoplot_output/
xdg-open nanoplot_output/NanoPlot-report.html

#Filtering the raw reads using Filtlong to determine the effect it may have on assembly

filtlong --min_length 1000 --keep_percent 90 -q 20 SRR32410565.1.fastq > SRR32410565.1_q20.fastq

